{
  "name": "usably-browser",
  "version": "1.0.0",
  "description": "Electron + Next.js web browser with sidebar",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:electron\"",
    "dev:web": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && pnpm build:electron && electron .",
    "build:web": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "pnpm build:web && pnpm build:electron",
    "start": "NODE_ENV=production electron dist/electron/main.js",
    "package": "pnpm build && electron-builder",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "keywords": [
    "electron",
    "nextjs",
    "browser"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.5",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-katex": "^3.0.4",
    "@types/three": "^0.182.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.2",
    "@tanstack/react-query": "^5.90.14",
    "@trpc/client": "^11.8.1",
    "@trpc/next": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-liquid-glass": "^1.1.1",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.23.26",
    "gsap": "^3.14.2",
    "iron-session": "^8.0.4",
    "jwt-decode": "^4.0.0",
    "katex": "^0.16.25",
    "lucide-react": "^0.562.0",
    "mathjs": "^14.9.1",
    "next": "^16.1.0",
    "next-auth": "^4.24.13",
    "ogl": "^1.0.11",
    "openid-client": "^6.8.1",
    "postprocessing": "^6.38.0",
    "prettier": "^3.7.4",
    "prettier-plugin-java": "^2.7.7",
    "query-string": "^9.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-icons": "^4.11.0",
    "react-katex": "^3.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.16.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-typing-game-hook": "^1.4.2",
    "redux-subscriber": "^1.1.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.167.1",
    "zod": "^4.2.1"
  },
  "build": {
    "appId": "com.usably.browser",
    "productName": "Usably Browser",
    "files": [
      "dist/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/electron/main.js"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
